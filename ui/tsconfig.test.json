{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* The tests read fixture files off disk and run under vitest, so they get
       node's globals and vitest's. The app config deliberately does not: with
       node types in `src`, a component could import `node:fs`, typecheck
       cleanly, and fail only in a browser. */
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": ["tests"]
}
