            {
              "value": "standard",
              "label": "Standard — plus records and DOLs"
            },
            {
              "value": "deep",
              "label": "Deep — plus SFI sweep"
            }
          ]
        }
      ]
    },
    {
      "key": "mutation",
      "icon": "swap",
      "title": "Mutation",
      "nodeClass": "transform",
      "summary": "Rewrites PDOL, AFL, DOL and response tags as the conversation passes.",
      "ports": [
        {
          "id": "terminal",
          "channel": "apdu",
          "role": "responder",
          "label": "terminal"
        },
        {
          "id": "card",
          "channel": "apdu",
          "role": "requester",
          "label": "card"
        }
      ],
      "latencyMs": 1,
      "fields": [
        {
          "kind": "yaml",
          "key": "playbook",
          "label": "Playbook",
          "default": "# Mutation rules, in atrium's playbook format.\n# Existing playbooks from atrium/playbooks/ paste in here unchanged.\nenabled: true\nlog_mutations: true\n\npdol_mutations:\n  - tag: \"9F02\"\n    value: \"000000000001\"\n    enabled: true\n    comment: \"Amount: 1 cent\"\n\nresponse_mutations: []\nafl_mutations: []\ndol_mutations: []\n",
          "rows": 18
        },
        {
          "kind": "bool",
          "key": "logMutations",
          "label": "Log every rewrite",
          "default": true
        }
      ]
    },
    {
      "key": "inject",
      "icon": "inject",
      "title": "Injection",
      "nodeClass": "transform",
      "summary": "Fires extra commands at the card around a trigger instruction.",
      "ports": [
        {
          "id": "terminal",
          "channel": "apdu",
          "role": "responder",
          "label": "terminal"
        },
        {
          "id": "card",
          "channel": "apdu",
          "role": "requester",
          "label": "card"
        },
        {
          "id": "oob",
          "channel": "apdu",
          "role": "requester",
          "label": "out of band",
          "oob": true
        }
      ],
      "latencyMs": 1,
      "fields": [
        {
          "kind": "hex",
          "key": "triggerIns",
          "label": "Trigger INS",
          "default": "AE",
          "placeholder": "AE"
        },
        {
          "kind": "select",
          "key": "when",
          "label": "When",
          "default": "after_response",
          "options": [
            {
              "value": "before_command",
              "label": "Before the command"
            },
            {
              "value": "after_response",
              "label": "After the response"
            }
          ]
        },
        {
          "kind": "hex",
          "key": "apdu",
          "label": "APDU to inject",
          "placeholder": "80CA9F3600"
        },
        {
          "kind": "bool",
          "key": "repeat",
          "label": "Fire every time",
          "default": false
        }
      ],
      "caveats": [
        "The injected command reaches the card out of band, so it spends the round trip twice. Free on contact, and enough to time a contactless tap out."
      ]
    },
    {
      "key": "trace",
      "icon": "eye",
      "title": "Trace tap",
