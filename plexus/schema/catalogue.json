    {
      "key": "nfcgate",
      "icon": "phone",
      "title": "NFCGate session",
      "nodeClass": "card",
      "summary": "A card held in an Android phone's field, reached through an NFCGate server.",
      "ports": [
        {
          "id": "terminal",
          "channel": "apdu",
          "role": "responder",
          "label": "terminal"
        }
      ],
      "device": "nfcgate",
      "latencyMs": 35,
      "fields": [
