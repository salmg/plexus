    {
      "key": "swtx",
      "icon": "clock",
      "title": "Timing",
      "nodeClass": "transform",
      "summary": "Asks the terminal for more time with S(WTX) when the card is slow.",
      "ports": [
        {
          "id": "terminal",
          "channel": "apdu",
          "role": "responder",
          "label": "terminal"
        },
        {
          "id": "card",
          "channel": "apdu",
          "role": "requester",
          "label": "card"
        }
      ],
      "latencyMs": 0,
      "fields": [
        {
          "kind": "number",
          "key": "wtxm",
          "label": "WTX multiplier",
          "default": 4,
          "min": 1,
          "max": 59
        },
        {
          "kind": "number",
          "key": "thresholdMs",
          "label": "Request above (ms)",
          "default": 200,
          "min": 0
        }
      ],
      "caveats": [
        "Buys time on contact. A contactless kernel may refuse it and drop the transaction."
      ]
    },
    {
