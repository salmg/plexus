          "kind": "text",
          "key": "host",
          "label": "vpcd host",
          "default": "127.0.0.1",
          "reaches": "address"
        },
        {
          "kind": "number",
          "key": "port",
          "label": "vpcd port",
          "default": 35963,
          "min": 1,
          "max": 65535
        }
      ],
      "caveats": [
        "Needs virtualsmartcard installed and vpcd loaded into pcscd."
      ]
    },
    {
      "key": "agent",
      "icon": "agent",
      "title": "EMV agent",
      "nodeClass": "terminal",
