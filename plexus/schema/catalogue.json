        {
          "kind": "select",
          "key": "provider",
          "label": "Model",
          "default": "anthropic",
          "options": [
            {
              "value": "anthropic",
              "label": "Anthropic"
            },
            {
              "value": "openai",
              "label": "OpenAI-compatible"
            },
            {
              "value": "local",
              "label": "Local (Ollama, vLLM, llama.cpp)"
