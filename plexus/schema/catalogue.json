          ]
        },
        {
          "kind": "bool",
          "key": "bruteSfi",
          "label": "Brute-force SFI range",
          "default": false
        }
      ],
      "caveats": [
        "Drives the card on its own. Point it at a card you own."
      ]
    },
    {
      "key": "probe",
      "icon": "probe",
      "title": "Fingerprint probe",
      "nodeClass": "terminal",
      "summary": "Runs atrium's fingerprint sequence and records what the card answers.",
      "ports": [
        {
          "id": "card",
          "channel": "apdu",
          "role": "requester",
          "label": "card"
